<Application x:Class="ClipRemote.Agent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#14171A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#20252B" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F6F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB2BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#42B883" />
    </Application.Resources>
</Application>
